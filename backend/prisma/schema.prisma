  kind                    RegulatoryTerritoryKind
  istatCode               String                  @map("istat_code")
  name                    String
  parentId                String?                 @map("parent_id")
  parent                  RegulatoryTerritory?    @relation("TerritoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                RegulatoryTerritory[]   @relation("TerritoryHierarchy")
  population              Int?
  populationReferenceDate DateTime?               @map("population_reference_date") @db.Date
  validFrom               DateTime                @map("valid_from") @db.Date
  validTo                 DateTime?               @map("valid_to") @db.Date
