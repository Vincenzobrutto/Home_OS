// HomeOS — schema Prisma
// Ricalca 1:1 il modello dati definito in homeos_architettura_tecnica.md (§3).
// Stack di riferimento: NestJS + PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUM — allineati 1:1 ai tipi già fissati nel prototipo React (ROOM_TYPES,
// ASSET_TYPES). Se nel prototipo cambia un'etichetta, qui va aggiornato il
// value corrispondente, non la chiave dell'enum.
// ---------------------------------------------------------------------------

enum RoomType {
  CUCINA
  SOGGIORNO
  CAMERA
  BAGNO
}

enum AssetType {
  CALDAIA
  ELETTRICO
  IDRAULICO
  FOTOVOLTAICO
  CLIMA
  TETTO
  FINESTRE
  ELETTRODOMESTICO
}

// Calcolato dall'applicazione (garanzie scadute, documenti mancanti), non
// impostato manualmente dall'utente — vedi §6 del documento di architettura.
enum AssetStatus {
  OK
  ATTENTION
  DUE
}

// Origine del VALORE, non se qualcuno l'ha approvato — quello è un fatto a
// parte (vedi AssetFieldProvenance.confirmedByUserId/confirmedAt sotto):
// ogni riga in DB è già di fatto "confermata" nell'atto stesso di scriverla.
// ATTESTED è predisposto per una futura verifica terza (banche/assicurazioni,
// vedi vision.md) — nessun codice lo scrive ancora oggi.
enum FieldSource {
  DECLARED
  EXTRACTED
  ATTESTED
}

enum DocumentStatus {
  PENDING
  ANALYZING
  ANALYZED
  CONFIRMED
}

enum DocumentSource {
  UPLOAD
  GMAIL
  DRIVE
}

enum MembershipRole {
  OWNER
  MEMBER
  VIEWER
}

enum MaintenanceRecurrenceUnit {
  NONE
  DAY
  MONTH
  YEAR
}

enum EvidenceStatus {
  VERIFIED_PRESENT
  DECLARED_PRESENT
  DECLARED_ABSENT
  UNKNOWN
  NOT_APPLICABLE
}

enum InterventionKind {
  INSTALLATION
  MAINTENANCE
  INSPECTION
  BREAKDOWN
  REPAIR
  REPLACEMENT
  OTHER
}

enum InterventionDocumentRole {
  INVOICE
  REPORT
  RECEIPT
  PHOTO
  WARRANTY_PROOF
  OTHER
}

enum WarrantyKind {
  PURCHASE
  REPAIR
  EXTENDED
  OTHER
}

enum ThermalServiceType {
  HEATING
  COOLING
  COMBINED
}

enum RegulatoryTerritoryKind {
  REGION
  METROPOLITAN_CITY
  PROVINCE
  MUNICIPALITY
}

enum PlantResponsibilityType {
  OCCUPANT
  OWNER
  LANDLORD
  CONDOMINIUM_ADMIN
  THIRD_PARTY
}

enum RegulatoryRuleStatus {
  DRAFT
  ACTIVE
  BLOCKED
  SUPERSEDED
  SUSPENDED
}

enum MaintenanceSubjectType {
  HOUSE
  THERMAL_SYSTEM
  ASSET
}

enum MaintenanceOrigin {
  USER
  GUIDELINE
  REGULATORY
}

// ---------------------------------------------------------------------------
// GENESIS — onboarding guidato "casa nuova, mai censita" (vedi
// docs/genesis-architecture.md). Room/Asset esistenti restano il modello
// primario: qui si estendono con provenienza/conferma invece di duplicarli.
// ---------------------------------------------------------------------------

enum GenesisStatus {
  NOT_STARTED
  IN_PROGRESS
  PROCESSING
  COMPLETED
}

enum GenesisStep {
  WELCOME
  HOUSE_INFO
  DOCUMENTS
  SCAN
  REVIEW
  RESULTS
}

// Riusato sia da Room che da Asset: come si è arrivati a quella riga, non
// solo "chi l'ha creata" — serve a distinguere ciò che l'utente ha inserito
// a mano da ciò che viene da una scansione/documento e attende conferma.
enum AcquisitionSource {
  MANUAL
  SCAN_MOCK
  DOCUMENT
  IMPORT
}

enum ScanSessionType {
  GUIDED_MOCK
  PHOTO
  VIDEO
}

enum ScanSessionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ObservationEntityType {
  ROOM
  ASSET
}

enum ObservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EDITED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  OPEN
  RESOLVED
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationStatus {
  OPEN
  DISMISSED
  DONE
}

// ---------------------------------------------------------------------------
// MODELLI
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  // Nullable: gli utenti creati prima dell'introduzione dell'autenticazione
  // reale (B2) non hanno ancora una password. Il login riconosce questo
  // caso e offre di impostarla, invece di richiedere una migrazione dati.
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedHouses                   House[]                @relation("HouseOwner")
  memberships                   HouseMembership[]
  gmailConnection               GmailConnection?
  driveConnection               DriveConnection?
  sessions                      Session[]
  // Provenienza (B38): campi di Asset che questo utente ha confermato
  // (scritti a mano, o accettati confermando un documento) — vedi
  // AssetFieldProvenance/AssetCustomField.
  confirmedFieldProvenance      AssetFieldProvenance[]
  confirmedCustomFields         AssetCustomField[]
  confirmedHouseFieldProvenance HouseFieldProvenance[]
  confirmedThermalSystems       ThermalSystem[]
  confirmedPlantBooklets        PlantBooklet[]
  plantResponsibilities         PlantResponsibility[]
  createdInterventions          Intervention[]         @relation("InterventionCreator")
  confirmedWarranties           Warranty[]             @relation("WarrantyConfirmer")

  @@map("users")
}

// Sessione di login: il valore di `id` è il token stesso (32 byte random,
// alta entropia) inviato al client come cookie httpOnly — non richiede una
// firma/secret separata per essere sicuro, e la revoca è un semplice
// `delete`. Preferito a JWT per semplicità (niente refresh token, niente
// libreria in più) e a un provider esterno (Auth0/Clerk/Supabase) per non
// introdurre un costo/vendor lock-in prima che serva davvero — vedi
// `decisions.md`.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

// Un solo account Gmail collegato per utente (per l'MVP). Token salvati in
// chiaro come DATABASE_URL in .env — coerente con la fase attuale del
// progetto, da rivedere prima di un vero deploy multi-utente.
model GmailConnection {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String   @map("google_email")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   DateTime @map("expiry_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gmail_connections")
}

// Un solo account/cartella Google Drive collegato per utente (per l'MVP,
// come GmailConnection sopra). Scope drive.readonly + selezione cartella
// dalla nostra UI invece del Picker: più semplice, coerente con l'approccio
// già validato per Gmail (redirect server-side, niente JS client-side).
model DriveConnection {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String   @map("google_email")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   DateTime @map("expiry_date")
  // null finché l'utente non ha scelto quale cartella scansionare.
  folderId     String?  @map("folder_id")
  folderName   String?  @map("folder_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("drive_connections")
}

model House {
  id                        String        @id @default(uuid())
  ownerId                   String        @map("owner_id")
  owner                     User          @relation("HouseOwner", fields: [ownerId], references: [id])
  name                      String
  city                      String?
  province                  String?
  surfaceSqm                Decimal?      @map("surface_sqm")
  roomsCount                Int?          @map("rooms_count")
  buildYear                 Int?          @map("build_year")
  code                      String        @unique
  createdAt                 DateTime      @default(now()) @map("created_at")
  // Rotazione (0/90/180/270) applicata alla vista mappa della planimetria —
  // ambienti e asset vengono ruotati "sul serio" (le loro coordinate
  // salvate) quando l'utente ruota la vista, così l'immagine di sfondo
  // caricata dall'utente deve essere ruotata della stessa quantità per
  // restare allineata; persistito qui perché il file di sfondo non cambia
  // da solo tra un caricamento e l'altro. Vedi FloorPlan.tsx.
  floorPlanRotation         Int           @default(0) @map("floor_plan_rotation")
  // Campi aggiunti per il wizard Genesis (step "House Information") — tutti
  // opzionali per non rompere le case già esistenti create prima di Genesis.
  address                   String?
  postalCode                String?       @map("postal_code")
  propertyType              String?       @map("property_type")
  country                   String?
  cadastralMunicipality     String?       @map("cadastral_municipality")
  cadastralMunicipalityCode String?       @map("cadastral_municipality_code")
  municipalityIstatCode     String?       @map("municipality_istat_code")
  cadastralSection          String?       @map("cadastral_section")
  cadastralSheet            String?       @map("cadastral_sheet")
  cadastralParcel           String?       @map("cadastral_parcel")
  cadastralSubaltern        String?       @map("cadastral_subaltern")
  cadastralCategory         String?       @map("cadastral_category")
  cadastralClass            String?       @map("cadastral_class")
  cadastralConsistency      String?       @map("cadastral_consistency")
  cadastralSurfaceSqm       Decimal?      @map("cadastral_surface_sqm") @db.Decimal(10, 2)
  cadastralIncome           Decimal?      @map("cadastral_income") @db.Decimal(12, 2)
  floorsCount               Int?          @map("floors_count")
  usableSurfaceSqm          Decimal?      @map("usable_surface_sqm") @db.Decimal(10, 2)
  heatedSurfaceSqm          Decimal?      @map("heated_surface_sqm") @db.Decimal(10, 2)
  renovationYear            Int?          @map("renovation_year")
  apeCode                   String?       @map("ape_code")
  apeIssuedAt               DateTime?     @map("ape_issued_at") @db.Date
  apeExpiresAt              DateTime?     @map("ape_expires_at") @db.Date
  energyClass               String?       @map("energy_class")
  epglNren                  Decimal?      @map("epgl_nren") @db.Decimal(12, 3)
  epglRen                   Decimal?      @map("epgl_ren") @db.Decimal(12, 3)
  co2Emissions              Decimal?      @map("co2_emissions") @db.Decimal(12, 3)
  climateZone               String?       @map("climate_zone")
  energyUseCategory         String?       @map("energy_use_category")
  habitabilityStatus        String?       @map("habitability_status")
  habitabilityDate          DateTime?     @map("habitability_date") @db.Date
  habitabilityProtocol      String?       @map("habitability_protocol")
  genesisStatus             GenesisStatus @default(NOT_STARTED) @map("genesis_status")
  genesisStep               GenesisStep   @default(WELCOME) @map("genesis_step")

  rooms                 Room[]
  assets                Asset[]
  documents             Document[]
  memberships           HouseMembership[]
  contacts              Contact[]
  floors                Floor[]
  scanSessions          ScanSession[]
  issues                Issue[]
  recommendations       Recommendation[]
  scoreSnapshots        ScoreSnapshot[]
  timelineEvents        HouseTimelineEvent[]
  utilityBills          UtilityBill[]
  fieldProvenance       HouseFieldProvenance[]
  thermalSystems        ThermalSystem[]
  maintenancePlans      MaintenancePlan[]
  plantResponsibilities PlantResponsibility[]
  interventions         Intervention[]

  @@map("houses")
}

// Provenienza dell'ultimo valore noto dei campi strutturati del Property
// Profile. Come per AssetFieldProvenance, origine e conferma sono due assi
// distinti e non viene inventato uno storico retroattivo per dati preesistenti.
model HouseFieldProvenance {
  id                String      @id @default(uuid())
  houseId           String      @map("house_id")
  house             House       @relation(fields: [houseId], references: [id], onDelete: Cascade)
  fieldName         String      @map("field_name")
  origin            FieldSource
  sourceDocumentId  String?     @map("source_document_id")
  sourceDocument    Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  confirmedByUserId String?     @map("confirmed_by_user_id")
  confirmedByUser   User?       @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt       DateTime    @map("confirmed_at")

  @@unique([houseId, fieldName])
  @@map("house_field_provenance")
}

// Piano dell'edificio (es. "Piano terra", "Primo piano") — concetto nuovo,
// prima non modellato: le Room esistenti non avevano bisogno di un piano
// perché la planimetria era sempre a livello unico. Opzionale su Room per
// non richiederlo alle case già esistenti.
model Floor {
  id        String   @id @default(uuid())
  houseId   String   @map("house_id")
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  name      String
  level     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms Room[]

  @@map("floors")
}

model HouseMembership {
  id        String         @id @default(uuid())
  houseId   String         @map("house_id")
  house     House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id])
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now()) @map("created_at")

  // Predisposta fin dall'MVP anche se oggi ogni casa ha un solo proprietario:
  // evita una migrazione dolorosa quando arriverà la condivisione (coniuge,
  // amministratore di condominio, artigiano) — vedi §3 dell'architettura.
  @@unique([houseId, userId])
  @@map("house_memberships")
}

model Room {
  id           String            @id @default(uuid())
  houseId      String            @map("house_id")
  house        House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  floorId      String?           @map("floor_id")
  floor        Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  type         RoomType
  name         String
  code         String            @unique
  // Coordinate reali della stanza quando disponibili da una planimetria vera
  // (nel prototipo è solo una griglia generata). Nullable finché non c'è.
  planGeometry Json?             @map("plan_geometry")
  // Provenienza + fiducia dell'osservazione che ha originato la riga (vedi
  // Observation) — null/MANUAL per le stanze create a mano come sempre.
  // `confirmed` di default true: solo le stanze nate da una scansione non
  // ancora confermata partono false, così non serve toccare nulla per le
  // stanze già esistenti prima di Genesis.
  confidence   Float?
  source       AcquisitionSource @default(MANUAL)
  confirmed    Boolean           @default(true)

  assets Asset[]

  @@map("rooms")
}

model Asset {
  id                       String            @id @default(uuid())
  houseId                  String            @map("house_id")
  house                    House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  // null = impianto di casa, non legato a una stanza specifica
  roomId                   String?           @map("room_id")
  room                     Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  thermalSystemId          String?           @map("thermal_system_id")
  thermalSystem            ThermalSystem?    @relation(fields: [thermalSystemId], references: [id], onDelete: SetNull)
  type                     AssetType
  name                     String
  code                     String            @unique
  installedAt              DateTime?         @map("installed_at") @db.Date
  warrantyUntil            DateTime?         @map("warranty_until") @db.Date
  // Campi strutturati universali (validi per qualunque tipo di asset, a
  // differenza di dati specifici come "potenza caldaia" che restano
  // AssetCustomField). Popolati dal primo documento disponibile che li
  // riporta e mai più sovrascritti — vedi applyFieldsToAsset in
  // documents.service.ts: "riempi solo i vuoti", non aggiorna un valore
  // già presente nemmeno se un documento successivo ne indica uno diverso.
  serialNumber             String?           @map("serial_number")
  manufacturer             String?
  model                    String?
  purchasedAt              DateTime?         @map("purchased_at") @db.Date
  supplier                 String?
  refrigerant              String?
  refrigerantChargeKg      Decimal?          @map("refrigerant_charge_kg") @db.Decimal(10, 3)
  hermeticallySealed       Boolean?          @map("hermetically_sealed")
  sealedLabelPresent       Boolean?          @map("sealed_label_present")
  leakDetectionSystem      Boolean?          @map("leak_detection_system")
  status                   AssetStatus       @default(ATTENTION)
  // Posizione relativa (0–1) nella cella della planimetria generata
  planPosX                 Decimal?          @map("plan_pos_x")
  planPosY                 Decimal?          @map("plan_pos_y")
  // Stato di ciclo vita impostato direttamente dall'utente (non calcolato,
  // a differenza di "status" sopra): un asset dismesso esce dall'elenco
  // attivo ma tiene tutti i suoi dati (campi, documenti, cronologia).
  dismissedAt              DateTime?         @map("dismissed_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  // Stima grezza per il calcolo di efficienza/Home Score — non una diagnosi,
  // solo "tra quanti anni potrebbe aver senso valutare una sostituzione".
  estimatedReplacementYear Int?              @map("estimated_replacement_year")
  // Stessa semantica di Room.confidence/source/confirmed sopra.
  confidence               Float?
  source                   AcquisitionSource @default(MANUAL)
  confirmed                Boolean           @default(true)

  customFields                    AssetCustomField[]
  fieldProvenance                 AssetFieldProvenance[]
  documents                       Document[]
  timelineEvents                  AssetTimelineEvent[]
  maintenancePlans                MaintenancePlan[]
  maintenanceOccurrences          MaintenanceOccurrence[]
  dismissedMaintenanceSuggestions DismissedMaintenanceSuggestion[]
  efficiencyControlReports        EfficiencyControlReport[]
  interventionLinks               InterventionAsset[]
  warranties                      Warranty[]

  @@map("assets")
}

model AssetCustomField {
  id                String      @id @default(uuid())
  assetId           String      @map("asset_id")
  asset             Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label             String
  value             String
  source            FieldSource @default(DECLARED)
  // Provenienza (B38): nulli per i campi già esistenti prima di questa
  // modifica (non conosciamo la loro vera origine) e per i campi creati a
  // mano — valorizzati solo quando source = EXTRACTED, dal documento e
  // dall'utente che ha confermato la scrittura.
  sourceDocumentId  String?     @map("source_document_id")
  sourceDocument    Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  confirmedByUserId String?     @map("confirmed_by_user_id")
  confirmedByUser   User?       @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt       DateTime?   @map("confirmed_at")

  @@map("asset_custom_fields")
}

// Provenienza dei 7 campi strutturati "universali" di Asset (vedi commento
// su Asset sotto) — a differenza di AssetCustomField questi campi vivono
// come colonne dirette su Asset (servono tipizzati per query/ordinamento),
// quindi la loro provenienza vive in una tabella satellite dedicata invece
// che come colonne parallele per ognuno dei 7 campi. Un solo record per
// (assetId, fieldName): v1 traccia solo la provenienza dell'ultimo valore
// scritto, non uno storico di versioni precedenti.
model AssetFieldProvenance {
  id                String      @id @default(uuid())
  assetId           String      @map("asset_id")
  asset             Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  // Uno tra: installedAt, warrantyUntil, purchasedAt, serialNumber,
  // manufacturer, model, supplier — stringa e non enum perché è il nome di
  // un campo di Asset, non un valore di dominio a sé.
  fieldName         String      @map("field_name")
  origin            FieldSource
  sourceDocumentId  String?     @map("source_document_id")
  sourceDocument    Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  confirmedByUserId String?     @map("confirmed_by_user_id")
  confirmedByUser   User?       @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt       DateTime    @map("confirmed_at")

  @@unique([assetId, fieldName])
  @@map("asset_field_provenance")
}

model Document {
  id               String         @id @default(uuid())
  // Nullable finché il documento è in Inbox e non ancora confermato/associato
  assetId          String?        @map("asset_id")
  asset            Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  houseId          String         @map("house_id")
  house            House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  fileUrl          String         @map("file_url")
  originalFilename String         @map("original_filename")
  docType          String?        @map("doc_type")
  status           DocumentStatus @default(PENDING)
  aiConfidence     Decimal?       @map("ai_confidence")
  // Risultato grezzo dell'estrazione, prima della conferma utente —
  // l'AI non scrive mai direttamente su Asset/AssetCustomField (vedi §5).
  extractedFields  Json?          @map("extracted_fields")
  uploadedAt       DateTime       @default(now()) @map("uploaded_at")
  confirmedAt      DateTime?      @map("confirmed_at")
  // true solo se confermato esplicitamente con "collega alla casa, non a un
  // asset specifico" (es. APE, certificazione energetica generale) — non va
  // dedotto da assetId nullo, perché un Asset cancellato lascia assetId null
  // anche sui suoi documenti già confermati (onDelete: SetNull sopra) senza
  // che quello sia mai stata una scelta "a livello casa".
  houseLevel       Boolean        @default(false) @map("house_level")
  source           DocumentSource @default(UPLOAD)
  // Solo per source = GMAIL: da dove viene, per il dedup tra scansioni
  // ripetute e per mostrare mittente/oggetto nella vista "Candidati Gmail".
  gmailMessageId   String?        @map("gmail_message_id")
  emailFrom        String?        @map("email_from")
  emailSubject     String?        @map("email_subject")
  emailDate        DateTime?      @map("email_date")
  // Solo per source = DRIVE: id del file nella cartella collegata, per il
  // dedup tra scansioni ripetute della stessa cartella.
  driveFileId      String?        @map("drive_file_id")
  driveModifiedAt  DateTime?      @map("drive_modified_at")
  // null = candidato Gmail/Drive non ancora rivisto: non compare nell'Inbox
  // normale, solo nella vista candidati della relativa integrazione.
  // Valorizzato quando l'utente clicca "Importa" — da quel momento si
  // comporta come un documento caricato normalmente (analyze già fatto,
  // pronto per confirm).
  importedAt       DateTime?      @map("imported_at")
  // Candidato scartato ("Ignora", manualmente o automaticamente perché non
  // pertinente): resta in DB solo per non riproporlo alle scansioni
  // successive (dedup su gmailMessageId/driveFileId), non appare in nessuna vista.
  ignoredAt        DateTime?      @map("ignored_at")

  timelineEvents              AssetTimelineEvent[]
  maintenanceOccurrences      MaintenanceOccurrence[]
  utilityBills                UtilityBill[]
  // Provenienza (B38): campi di Asset (strutturati o liberi) che citano
  // questo documento come fonte — vedi AssetFieldProvenance/AssetCustomField.
  sourcedFieldProvenance      AssetFieldProvenance[]
  sourcedCustomFields         AssetCustomField[]
  sourcedHouseFieldProvenance HouseFieldProvenance[]
  sourcedThermalSystems       ThermalSystem[]
  sourcedPlantBooklets        PlantBooklet[]
  efficiencyControlReports    EfficiencyControlReport[]
  plantResponsibilities       PlantResponsibility[]
  interventionLinks           InterventionDocument[]
  warrantyProofs              Warranty[]                @relation("WarrantyProofDocument")

  @@unique([houseId, gmailMessageId])
  @@unique([houseId, driveFileId])
  @@map("documents")
}

// Periodo di consumo elettrico confermato dall'utente a partire da una
// bolletta. Un documento può contenere più periodi/riepiloghi; nessuna riga
// nasce direttamente dall'estrazione AI senza conferma esplicita.
model UtilityBill {
  id             String   @id @default(uuid())
  houseId        String   @map("house_id")
  house          House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  documentId     String   @map("document_id")
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  consumptionKwh Decimal  @map("consumption_kwh") @db.Decimal(12, 3)
  amount         Decimal? @db.Decimal(12, 2)
  supplier       String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([documentId, periodStart, periodEnd])
  @@index([houseId, periodStart, periodEnd])
  @@map("utility_bills")
}

model AssetTimelineEvent {
  id             String        @id @default(uuid())
  assetId        String        @map("asset_id")
  asset          Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventDate      DateTime      @map("event_date") @db.Date
  eventType      String        @map("event_type")
  detail         String?
  documentId     String?       @map("document_id")
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // Chi ha eseguito l'intervento, se noto — collegato dall'utente (Rubrica),
  // mai popolato automaticamente dall'AI (vedi START_HERE.md, "l'AI propone,
  // l'utente conferma").
  contactId      String?       @map("contact_id")
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Collegato solo quando l'audit/migrazione B47 ha riconosciuto in modo
  // univoco che questa riga legacy rappresenta lo stesso fatto canonico.
  interventionId String?       @map("intervention_id")
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@map("asset_timeline_events")
}

// Rubrica: tecnici/aziende che hanno lavorato in casa (es. "Idrotermica
// Bianchi"). Stessi nomi che compaiono nel campo "Fornitore" estratto dai
// documenti (vedi documents.service.ts extractSupplier), ma per l'MVP il
// collegamento è manuale — l'utente sceglie il contatto sull'intervento,
// niente auto-popolamento da AI qui (rimandato a un secondo momento).
model Contact {
  id        String   @id @default(uuid())
  houseId   String   @map("house_id")
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  timelineEvents            AssetTimelineEvent[]
  preferredMaintenancePlans MaintenancePlan[]
  maintenanceOccurrences    MaintenanceOccurrence[]
  interventions             Intervention[]
  warrantiesProvided        Warranty[]              @relation("WarrantyProvider")

  @@map("contacts")
}

model MaintenancePlan {
  id                 String                    @id @default(uuid())
  houseId            String                    @map("house_id")
  house              House                     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assetId            String?                   @map("asset_id")
  asset              Asset?                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  thermalSystemId    String?                   @map("thermal_system_id")
  thermalSystem      ThermalSystem?            @relation(fields: [thermalSystemId], references: [id], onDelete: Cascade)
  subjectType        MaintenanceSubjectType    @default(ASSET) @map("subject_type")
  origin             MaintenanceOrigin         @default(USER)
  regulatoryRuleId   String?                   @map("regulatory_rule_id")
  regulatoryRule     RegulatoryRule?           @relation(fields: [regulatoryRuleId], references: [id], onDelete: SetNull)
  generatedKey       String?                   @unique @map("generated_key")
  evidenceStatus     EvidenceStatus?           @map("evidence_status")
  sourceSnapshot     Json?                     @map("source_snapshot")
  title              String
  description        String?
  recurrenceUnit     MaintenanceRecurrenceUnit @default(NONE) @map("recurrence_unit")
  recurrenceInterval Int                       @default(1) @map("recurrence_interval")
  nextDueAt          DateTime                  @map("next_due_at") @db.Date
  reminderDaysBefore Int                       @default(30) @map("reminder_days_before")
  preferredContactId String?                   @map("preferred_contact_id")
  preferredContact   Contact?                  @relation(fields: [preferredContactId], references: [id], onDelete: SetNull)
  isMandatory        Boolean                   @default(false) @map("is_mandatory")
  notes              String?
  pausedAt           DateTime?                 @map("paused_at")
  completedAt        DateTime?                 @map("completed_at") @db.Date
  lastCompletedAt    DateTime?                 @map("last_completed_at") @db.Date
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  occurrences        MaintenanceOccurrence[]

  @@index([assetId, nextDueAt])
  @@index([houseId, nextDueAt])
  @@index([thermalSystemId, nextDueAt])
  @@map("maintenance_plans")
}

model ThermalSystem {
