// HomeOS — schema Prisma
// Ricalca 1:1 il modello dati definito in homeos_architettura_tecnica.md (§3).
// Stack di riferimento: NestJS + PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUM — allineati 1:1 ai tipi già fissati nel prototipo React (ROOM_TYPES,
// ASSET_TYPES). Se nel prototipo cambia un'etichetta, qui va aggiornato il
// value corrispondente, non la chiave dell'enum.
// ---------------------------------------------------------------------------

enum RoomType {
  CUCINA
  SOGGIORNO
  CAMERA
  BAGNO
}

enum AssetType {
  CALDAIA
  ELETTRICO
  IDRAULICO
  FOTOVOLTAICO
  CLIMA
  TETTO
  FINESTRE
  ELETTRODOMESTICO
}

// Calcolato dall'applicazione (garanzie scadute, documenti mancanti), non
// impostato manualmente dall'utente — vedi §6 del documento di architettura.
enum AssetStatus {
  OK
  ATTENTION
  DUE
}

enum FieldSource {
  MANUAL
  AI_EXTRACTED
}

enum DocumentStatus {
  PENDING
  ANALYZING
  ANALYZED
  CONFIRMED
}

enum DocumentSource {
  UPLOAD
  GMAIL
  DRIVE
}

enum MembershipRole {
  OWNER
  MEMBER
  VIEWER
}

enum MaintenanceRecurrenceUnit {
  NONE
  DAY
  MONTH
  YEAR
}

// ---------------------------------------------------------------------------
// GENESIS — onboarding guidato "casa nuova, mai censita" (vedi
// docs/genesis-architecture.md). Room/Asset esistenti restano il modello
// primario: qui si estendono con provenienza/conferma invece di duplicarli.
// ---------------------------------------------------------------------------

enum GenesisStatus {
  NOT_STARTED
  IN_PROGRESS
  PROCESSING
  COMPLETED
}

// Riusato sia da Room che da Asset: come si è arrivati a quella riga, non
// solo "chi l'ha creata" — serve a distinguere ciò che l'utente ha inserito
// a mano da ciò che viene da una scansione/documento e attende conferma.
enum AcquisitionSource {
  MANUAL
  SCAN_MOCK
  DOCUMENT
  IMPORT
}

enum ScanSessionType {
  GUIDED_MOCK
  PHOTO
  VIDEO
}

enum ScanSessionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ObservationEntityType {
  ROOM
  ASSET
}

enum ObservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EDITED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  OPEN
  RESOLVED
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationStatus {
  OPEN
  DISMISSED
  DONE
}

// ---------------------------------------------------------------------------
// MODELLI
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  ownedHouses     House[]           @relation("HouseOwner")
  memberships     HouseMembership[]
  gmailConnection GmailConnection?
  driveConnection DriveConnection?

  @@map("users")
}

// Un solo account Gmail collegato per utente (per l'MVP). Token salvati in
// chiaro come DATABASE_URL in .env — coerente con la fase attuale del
// progetto, da rivedere prima di un vero deploy multi-utente.
model GmailConnection {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String   @map("google_email")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   DateTime @map("expiry_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gmail_connections")
}

// Un solo account/cartella Google Drive collegato per utente (per l'MVP,
// come GmailConnection sopra). Scope drive.readonly + selezione cartella
// dalla nostra UI invece del Picker: più semplice, coerente con l'approccio
// già validato per Gmail (redirect server-side, niente JS client-side).
model DriveConnection {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String   @map("google_email")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   DateTime @map("expiry_date")
  // null finché l'utente non ha scelto quale cartella scansionare.
  folderId     String?  @map("folder_id")
  folderName   String?  @map("folder_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("drive_connections")
}

model House {
  id                String        @id @default(uuid())
  ownerId           String        @map("owner_id")
  owner             User          @relation("HouseOwner", fields: [ownerId], references: [id])
  name              String
  city              String?
  surfaceSqm        Decimal?      @map("surface_sqm")
  roomsCount        Int?          @map("rooms_count")
  buildYear         Int?          @map("build_year")
  code              String        @unique
  createdAt         DateTime      @default(now()) @map("created_at")
  // Rotazione (0/90/180/270) applicata alla vista mappa della planimetria —
  // ambienti e asset vengono ruotati "sul serio" (le loro coordinate
  // salvate) quando l'utente ruota la vista, così l'immagine di sfondo
  // caricata dall'utente deve essere ruotata della stessa quantità per
  // restare allineata; persistito qui perché il file di sfondo non cambia
  // da solo tra un caricamento e l'altro. Vedi FloorPlan.tsx.
  floorPlanRotation Int           @default(0) @map("floor_plan_rotation")
  // Campi aggiunti per il wizard Genesis (step "House Information") — tutti
  // opzionali per non rompere le case già esistenti create prima di Genesis.
  address           String?
  postalCode        String?       @map("postal_code")
  propertyType      String?       @map("property_type")
  country           String?
  genesisStatus     GenesisStatus @default(NOT_STARTED) @map("genesis_status")

  rooms           Room[]
  assets          Asset[]
  documents       Document[]
  memberships     HouseMembership[]
  contacts        Contact[]
  floors          Floor[]
  scanSessions    ScanSession[]
  issues          Issue[]
  recommendations Recommendation[]
  scoreSnapshots  ScoreSnapshot[]
  timelineEvents  HouseTimelineEvent[]

  @@map("houses")
}

// Piano dell'edificio (es. "Piano terra", "Primo piano") — concetto nuovo,
// prima non modellato: le Room esistenti non avevano bisogno di un piano
// perché la planimetria era sempre a livello unico. Opzionale su Room per
// non richiederlo alle case già esistenti.
model Floor {
  id        String   @id @default(uuid())
  houseId   String   @map("house_id")
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  name      String
  level     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms Room[]

  @@map("floors")
}

model HouseMembership {
  id        String         @id @default(uuid())
  houseId   String         @map("house_id")
  house     House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id])
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now()) @map("created_at")

  // Predisposta fin dall'MVP anche se oggi ogni casa ha un solo proprietario:
  // evita una migrazione dolorosa quando arriverà la condivisione (coniuge,
  // amministratore di condominio, artigiano) — vedi §3 dell'architettura.
  @@unique([houseId, userId])
  @@map("house_memberships")
}

model Room {
  id           String            @id @default(uuid())
  houseId      String            @map("house_id")
  house        House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  floorId      String?           @map("floor_id")
  floor        Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  type         RoomType
  name         String
  code         String            @unique
  // Coordinate reali della stanza quando disponibili da una planimetria vera
  // (nel prototipo è solo una griglia generata). Nullable finché non c'è.
  planGeometry Json?             @map("plan_geometry")
  // Provenienza + fiducia dell'osservazione che ha originato la riga (vedi
  // Observation) — null/MANUAL per le stanze create a mano come sempre.
  // `confirmed` di default true: solo le stanze nate da una scansione non
  // ancora confermata partono false, così non serve toccare nulla per le
  // stanze già esistenti prima di Genesis.
  confidence   Float?
  source       AcquisitionSource @default(MANUAL)
  confirmed    Boolean           @default(true)

  assets Asset[]

  @@map("rooms")
}

model Asset {
  id                       String            @id @default(uuid())
  houseId                  String            @map("house_id")
  house                    House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  // null = impianto di casa, non legato a una stanza specifica
  roomId                   String?           @map("room_id")
  room                     Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  type                     AssetType
  name                     String
  code                     String            @unique
  installedAt              DateTime?         @map("installed_at") @db.Date
  warrantyUntil            DateTime?         @map("warranty_until") @db.Date
  // Campi strutturati universali (validi per qualunque tipo di asset, a
  // differenza di dati specifici come "potenza caldaia" che restano
  // AssetCustomField). Popolati dal primo documento disponibile che li
  // riporta e mai più sovrascritti — vedi applyFieldsToAsset in
  // documents.service.ts: "riempi solo i vuoti", non aggiorna un valore
  // già presente nemmeno se un documento successivo ne indica uno diverso.
  serialNumber             String?           @map("serial_number")
  manufacturer             String?
  model                    String?
  purchasedAt              DateTime?         @map("purchased_at") @db.Date
  supplier                 String?
  status                   AssetStatus       @default(ATTENTION)
  // Posizione relativa (0–1) nella cella della planimetria generata
  planPosX                 Decimal?          @map("plan_pos_x")
  planPosY                 Decimal?          @map("plan_pos_y")
  // Stato di ciclo vita impostato direttamente dall'utente (non calcolato,
  // a differenza di "status" sopra): un asset dismesso esce dall'elenco
  // attivo ma tiene tutti i suoi dati (campi, documenti, cronologia).
  dismissedAt              DateTime?         @map("dismissed_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  // Stima grezza per il calcolo di efficienza/Home Score — non una diagnosi,
  // solo "tra quanti anni potrebbe aver senso valutare una sostituzione".
  estimatedReplacementYear Int?              @map("estimated_replacement_year")
  // Stessa semantica di Room.confidence/source/confirmed sopra.
  confidence               Float?
  source                   AcquisitionSource @default(MANUAL)
  confirmed                Boolean           @default(true)

  customFields                    AssetCustomField[]
  documents                       Document[]
  timelineEvents                  AssetTimelineEvent[]
  maintenancePlans                MaintenancePlan[]
  maintenanceOccurrences          MaintenanceOccurrence[]
  dismissedMaintenanceSuggestions DismissedMaintenanceSuggestion[]

  @@map("assets")
}

model AssetCustomField {
  id      String      @id @default(uuid())
  assetId String      @map("asset_id")
  asset   Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label   String
  value   String
  source  FieldSource @default(MANUAL)

  @@map("asset_custom_fields")
}

model Document {
  id               String         @id @default(uuid())
  // Nullable finché il documento è in Inbox e non ancora confermato/associato
  assetId          String?        @map("asset_id")
  asset            Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  houseId          String         @map("house_id")
  house            House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  fileUrl          String         @map("file_url")
  originalFilename String         @map("original_filename")
  docType          String?        @map("doc_type")
  status           DocumentStatus @default(PENDING)
  aiConfidence     Decimal?       @map("ai_confidence")
  // Risultato grezzo dell'estrazione, prima della conferma utente —
  // l'AI non scrive mai direttamente su Asset/AssetCustomField (vedi §5).
  extractedFields  Json?          @map("extracted_fields")
  uploadedAt       DateTime       @default(now()) @map("uploaded_at")
  confirmedAt      DateTime?      @map("confirmed_at")
  // true solo se confermato esplicitamente con "collega alla casa, non a un
  // asset specifico" (es. APE, certificazione energetica generale) — non va
  // dedotto da assetId nullo, perché un Asset cancellato lascia assetId null
  // anche sui suoi documenti già confermati (onDelete: SetNull sopra) senza
  // che quello sia mai stata una scelta "a livello casa".
  houseLevel       Boolean        @default(false) @map("house_level")
  source           DocumentSource @default(UPLOAD)
  // Solo per source = GMAIL: da dove viene, per il dedup tra scansioni
  // ripetute e per mostrare mittente/oggetto nella vista "Candidati Gmail".
  gmailMessageId   String?        @map("gmail_message_id")
  emailFrom        String?        @map("email_from")
  emailSubject     String?        @map("email_subject")
  emailDate        DateTime?      @map("email_date")
  // Solo per source = DRIVE: id del file nella cartella collegata, per il
  // dedup tra scansioni ripetute della stessa cartella.
  driveFileId      String?        @map("drive_file_id")
  driveModifiedAt  DateTime?      @map("drive_modified_at")
  // null = candidato Gmail/Drive non ancora rivisto: non compare nell'Inbox
  // normale, solo nella vista candidati della relativa integrazione.
  // Valorizzato quando l'utente clicca "Importa" — da quel momento si
  // comporta come un documento caricato normalmente (analyze già fatto,
  // pronto per confirm).
  importedAt       DateTime?      @map("imported_at")
  // Candidato scartato ("Ignora", manualmente o automaticamente perché non
  // pertinente): resta in DB solo per non riproporlo alle scansioni
  // successive (dedup su gmailMessageId/driveFileId), non appare in nessuna vista.
  ignoredAt        DateTime?      @map("ignored_at")

  timelineEvents         AssetTimelineEvent[]
  maintenanceOccurrences MaintenanceOccurrence[]

  @@unique([houseId, gmailMessageId])
  @@unique([houseId, driveFileId])
  @@map("documents")
}

model AssetTimelineEvent {
  id         String    @id @default(uuid())
  assetId    String    @map("asset_id")
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventDate  DateTime  @map("event_date") @db.Date
  eventType  String    @map("event_type")
  detail     String?
  documentId String?   @map("document_id")
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // Chi ha eseguito l'intervento, se noto — collegato dall'utente (Rubrica),
  // mai popolato automaticamente dall'AI (vedi START_HERE.md, "l'AI propone,
  // l'utente conferma").
  contactId  String?   @map("contact_id")
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@map("asset_timeline_events")
}

// Rubrica: tecnici/aziende che hanno lavorato in casa (es. "Idrotermica
// Bianchi"). Stessi nomi che compaiono nel campo "Fornitore" estratto dai
// documenti (vedi documents.service.ts extractSupplier), ma per l'MVP il
// collegamento è manuale — l'utente sceglie il contatto sull'intervento,
// niente auto-popolamento da AI qui (rimandato a un secondo momento).
model Contact {
  id        String   @id @default(uuid())
  houseId   String   @map("house_id")
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  timelineEvents            AssetTimelineEvent[]
  preferredMaintenancePlans MaintenancePlan[]
  maintenanceOccurrences    MaintenanceOccurrence[]

  @@map("contacts")
}

model MaintenancePlan {
  id                 String                    @id @default(uuid())
  assetId            String                    @map("asset_id")
  asset              Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  recurrenceUnit     MaintenanceRecurrenceUnit @default(NONE) @map("recurrence_unit")
  recurrenceInterval Int                       @default(1) @map("recurrence_interval")
  nextDueAt          DateTime                  @map("next_due_at") @db.Date
  reminderDaysBefore Int                       @default(30) @map("reminder_days_before")
  preferredContactId String?                   @map("preferred_contact_id")
  preferredContact   Contact?                  @relation(fields: [preferredContactId], references: [id], onDelete: SetNull)
  isMandatory        Boolean                   @default(false) @map("is_mandatory")
  notes              String?
  pausedAt           DateTime?                 @map("paused_at")
  completedAt        DateTime?                 @map("completed_at") @db.Date
  lastCompletedAt    DateTime?                 @map("last_completed_at") @db.Date
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  occurrences        MaintenanceOccurrence[]

  @@index([assetId, nextDueAt])
  @@map("maintenance_plans")
}

model MaintenanceOccurrence {
  id                String          @id @default(uuid())
  maintenancePlanId String          @map("maintenance_plan_id")
  maintenancePlan   MaintenancePlan @relation(fields: [maintenancePlanId], references: [id], onDelete: Cascade)
  assetId           String          @map("asset_id")
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scheduledFor      DateTime        @map("scheduled_for") @db.Date
  completedAt       DateTime        @map("completed_at") @db.Date
  contactId         String?         @map("contact_id")
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  documentId        String?         @map("document_id")
  document          Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([maintenancePlanId, completedAt])
  @@map("maintenance_occurrences")
}

// "Ignora" su un suggerimento di manutenzione (vedi maintenance-guidelines.ts)
// — persistito per non riproporre la stessa linea guida ad ogni apertura
// della scheda Asset (vedi decisions.md #22, correzione di #19). guidelineCode
// non è una foreign key: le linee guida sono definite nel codice, non in DB.
model DismissedMaintenanceSuggestion {
  id            String   @id @default(uuid())
  assetId       String   @map("asset_id")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  guidelineCode String   @map("guideline_code")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([assetId, guidelineCode])
  @@map("dismissed_maintenance_suggestions")
}

// Una sessione di acquisizione Genesis (oggi solo GUIDED_MOCK: un dataset
// demo deterministico, non una vera computer vision — vedi
// docs/genesis-architecture.md sul confine mock/reale).
model ScanSession {
  id          String            @id @default(uuid())
  houseId     String            @map("house_id")
  house       House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  type        ScanSessionType
  status      ScanSessionStatus @default(PENDING)
  startedAt   DateTime          @default(now()) @map("started_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  observations Observation[]

  @@map("scan_sessions")
}

// Un elemento proposto da una ScanSession, in attesa di conferma — non
// diventa mai Room/Asset da sola: solo quando l'utente conferma (vedi
// GenesisService.confirmObservations) nasce la riga reale, con
// source=SCAN_MOCK e la stessa confidence qui salvata.
model Observation {
  id               String                @id @default(uuid())
  scanSessionId    String                @map("scan_session_id")
  scanSession      ScanSession           @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)
  entityType       ObservationEntityType @map("entity_type")
  proposedName     String                @map("proposed_name")
  proposedCategory String?               @map("proposed_category")
  confidence       Float
  // Dati liberi specifici del tipo di osservazione — per ASSET include il
  // nome della stanza proposta (payload.roomName), usato per collegare
  // l'asset alla Room osservata nello stesso giro di scansione senza dover
  // già avere un roomId reale (la Room potrebbe non essere ancora
  // confermata quando l'Observation viene creata).
  payload          Json
  status           ObservationStatus     @default(PENDING)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@map("observations")
}

// Problema rilevato da Home Detective (regole deterministiche, vedi
// common/home-detective.ts) — MAI da un LLM in questo MVP. Idempotenza per
// (houseId, ruleCode, assetId, documentId) gestita a livello applicativo,
// non con un vincolo unique: assetId/documentId nullable renderebbero un
// indice unique poco affidabile tra database diversi, e la query "esiste
// già una issue OPEN con questo ruleCode+contesto" è comunque necessaria
// per decidere se riaprire una issue risolta.
model Issue {
  id             String        @id @default(uuid())
  houseId        String        @map("house_id")
  house          House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assetId        String?       @map("asset_id")
  documentId     String?       @map("document_id")
  category       String
  severity       IssueSeverity
  title          String
  description    String
  resolutionHint String?       @map("resolution_hint")
  status         IssueStatus   @default(OPEN)
  // Codice della regola che l'ha generata (es. HEATING_SYSTEM_WITHOUT_DOCUMENTATION)
  // — non una foreign key, le regole vivono nel codice, non in DB (stesso
  // principio di DismissedMaintenanceSuggestion.guidelineCode).
  ruleCode       String        @map("rule_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  resolvedAt     DateTime?     @map("resolved_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  recommendations Recommendation[]

  @@index([houseId, ruleCode, status])
  @@map("issues")
}

// Azione consigliata derivata (oggi 1:1) da una Issue aperta — separata
// dalla Issue stessa perché una issue descrive un problema, una
// recommendation descrive cosa fare: tenerle distinte permette in futuro
// più raccomandazioni per lo stesso problema, o raccomandazioni senza una
// issue collegata (es. ottimizzazioni non urgenti).
model Recommendation {
  id              String                 @id @default(uuid())
  houseId         String                 @map("house_id")
  house           House                  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  issueId         String?                @map("issue_id")
  issue           Issue?                 @relation(fields: [issueId], references: [id], onDelete: SetNull)
  category        String
  title           String
  description     String
  priority        RecommendationPriority
  estimatedImpact String?                @map("estimated_impact")
  status          RecommendationStatus   @default(OPEN)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@map("recommendations")
}

// Fotografia nel tempo del calcolo Home Score (common/home-score.ts) — mai
// ricalcolato "sul vecchio", ogni chiamata al servizio crea uno snapshot
// nuovo, così la Dashboard può mostrare una variazione rispetto
// all'ultimo. calculationVersion permette di riconoscere snapshot calcolati
// con una versione precedente della formula se in futuro cambiano i pesi.
model ScoreSnapshot {
  id                 String   @id @default(uuid())
  houseId            String   @map("house_id")
  house              House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  overallScore       Int      @map("overall_score")
  documentationScore Int      @map("documentation_score")
  maintenanceScore   Int      @map("maintenance_score")
  safetyScore        Int      @map("safety_score")
  efficiencyScore    Int      @map("efficiency_score")
  completenessScore  Int      @map("completeness_score")
  calculationVersion String   @map("calculation_version")
  calculatedAt       DateTime @default(now()) @map("calculated_at")

  @@index([houseId, calculatedAt])
  @@map("score_snapshots")
}

// Eventi a livello di CASA (creazione, scansione completata, Home Score
// calcolato...) — distinto deliberatamente da AssetTimelineEvent invece di
// generalizzare quest'ultimo: AssetTimelineEvent è già in uso reale con
// assetId obbligatorio, e ha una semantica precisa (interventi su un
// asset). Retrofittarlo per eventi che non riguardano nessun asset
// specifico avrebbe richiesto rendere assetId opzionale su una tabella già
// viva, con rischio di rompere query esistenti — più sicuro un modello
// nuovo, piccolo, per un concetto genuinamente diverso.
model HouseTimelineEvent {
  id          String   @id @default(uuid())
  houseId     String   @map("house_id")
  house       House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assetId     String?  @map("asset_id")
  documentId  String?  @map("document_id")
  type        String
  title       String
  description String?
  eventDate   DateTime @default(now()) @map("event_date")
  source      String   @default("system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([houseId, eventDate])
  @@map("house_timeline_events")
}
