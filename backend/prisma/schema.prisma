  family            String
  territoryId       String?              @map("territory_id")
  territory         RegulatoryTerritory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  scope             Json
  conditions        Json
  effect            Json
  sourceTitle       String               @map("source_title")
  sourceUrl         String               @map("source_url")
  sourcePublishedAt DateTime?            @map("source_published_at") @db.Date
  verifiedAt        DateTime             @map("verified_at")
  verifiedBy        String?              @map("verified_by")
  validFrom         DateTime             @map("valid_from") @db.Date
  validTo           DateTime?            @map("valid_to") @db.Date
  status            RegulatoryRuleStatus @default(DRAFT)
  supersedesRuleId  String?              @map("supersedes_rule_id")
  supersedesRule    RegulatoryRule?      @relation("RuleSupersession", fields: [supersedesRuleId], references: [id], onDelete: SetNull)
  supersededBy      RegulatoryRule[]     @relation("RuleSupersession")
  notes             String?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  maintenancePlans MaintenancePlan[]

