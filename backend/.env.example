DATABASE_URL="postgresql://utente:password@localhost:5432/homeos"
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"

# Integrazione Gmail e Drive (stesso progetto/Client OAuth di Google Cloud
# Console > APIs & Services > Credentials, due redirect URI distinti)
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/gmail/callback"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/auth/drive/callback"

# Opzionale — dove reindirizzare il browser dopo il completamento dell'OAuth
# Gmail/Drive. Se omessa, default a http://localhost:5173.
FRONTEND_ORIGIN="http://localhost:5173"
