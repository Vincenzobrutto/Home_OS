{
  "name": "dimora-v5-backend", "version": "0.1.0", "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json", "lint": "eslint src test", "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "test": "node --test test/domain.test.cjs test/documents.test.cjs test/multipart.test.cjs",
    "test:integration": "node --env-file=.env --test --test-concurrency=1 test/integration.test.cjs test/documents.integration.test.cjs",
    "db:generate": "prisma generate", "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28", "@nestjs/core": "11.1.28", "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3", "class-transformer": "0.5.1", "class-validator": "0.15.1",
    "cookie-parser": "1.4.7", "reflect-metadata": "0.2.2", "rxjs": "7.8.2", "archiver": "7.0.1", "file-type": "21.3.4"
  },
  "devDependencies": {"prisma": "6.19.3", "typescript": "5.9.3", "@types/express": "5.0.6", "@types/cookie-parser": "1.4.10", "@types/node": "24.13.3", "eslint": "9.39.5", "@eslint/js": "9.39.5", "typescript-eslint": "8.65.0", "globals": "17.8.0", "@types/archiver": "7.0.0"}
}
