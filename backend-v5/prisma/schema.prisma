generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum HomeRole {
  owner
  member
  viewer
}
model Account {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
  memberships HomeMembership[]
  requests HomeRequest[]
  documents Document[]
  uploads UploadRequest[]
  analysisJobs AnalysisJob[]
  boilerAssets BoilerAsset[]
  reviewRequests ReviewRequest[]
  activities HomeActivity[]
  activityRequests ActivityRequest[]
  activityHistory ActivityHistory[]
}
model Session {
  id String @id
  accountId String?
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Home {
  id String @id @default(uuid())
  name String
  address String
  version Int @default(1)
  createdAt DateTime @default(now())
  memberships HomeMembership[]
  requests HomeRequest[]
  documents Document[]
  uploads UploadRequest[]
  analysisJobs AnalysisJob[]
  boilerAssets BoilerAsset[]
  reviewRequests ReviewRequest[]
  activities HomeActivity[]
  activityRequests ActivityRequest[]
}
model HomeMembership {
  id String @id @default(uuid())
  accountId String
  homeId String
  role HomeRole @default(owner)
  validFrom DateTime @default(now())
  validUntil DateTime?
  revokedAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([accountId, homeId])
}
model HomeRequest {
  id String @id @default(uuid())
  accountId String
  key String
  digest String
  homeId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([accountId, key])
}

enum DocumentVisibility {
  private
  home
}
model Document {
  id String @id @default(uuid())
  homeId String
  uploaderId String
  name String
  visibility DocumentVisibility @default(private)
  createdAt DateTime @default(now())
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  uploader Account @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  original DocumentVersion?
  requests UploadRequest[]
  @@index([homeId, createdAt, id])
}
model DocumentVersion {
  id String @id @default(uuid())
  documentId String @unique
  version Int @default(1)
  originalFilename String
  mimeType String
  byteSize Int
  sha256 String
  fileId String @unique
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
}
model StoredFile {
  id String @id @default(uuid())
  storageKey String @unique
  createdAt DateTime @default(now())
  original DocumentVersion?
}
model UploadRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  key String
  digest String
  documentId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, key])
}

model BoilerAsset {
  activities HomeActivity[]
  id String @id @default(uuid())
  homeId String
  accountId String
  name String
  version Int @default(1)
  confirmed Json @default("{}")
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  jobs AnalysisJob[]
  proposals FieldProposal[]
  history AssetHistory[]
  @@index([accountId, homeId, createdAt, id])
}

enum ActivityState {
  open
  completed
  cancelled
}
model HomeActivity {
  id String @id @default(uuid())
  accountId String
  homeId String
  assetId String?
  title String
  description String?
  dueDate String?
  state ActivityState @default(open)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  completedAt DateTime?
  cancelledAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  asset BoilerAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  history ActivityHistory[]
  @@index([accountId, homeId, state, dueDate, createdAt, id])
}
model ActivityHistory {
  id String @id @default(uuid())
  activityId String
  accountId String
  at DateTime @default(now())
  kind String
  note String?
  before Json?
  after Json
  activity HomeActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([activityId, at, id])
}
model ActivityRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  operation String
  target String
  key String
  digest String
  response Json
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, operation, target, key])
}
model AnalysisJob {
  id String @id @default(uuid())
  homeId String
  accountId String
  assetId String?
  parentJobId String?
  state String @default("queued")
  documents Json
  createdAt DateTime @default(now())
  firstStartedAt DateTime?
  finishedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  outcome String?
  openReviewCount Int?
  error Json?
  provider String @default("test_fixture_v1")
  model String?
  consentToProviderTransfer Boolean @default(false)
  attempt AiAttempt?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  asset BoilerAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  proposals FieldProposal[]
  @@index([state, leaseUntil])
  @@index([accountId, homeId, createdAt, id])
}
model FieldProposal {
  id String @id @default(uuid())
  assetId String
  jobId String
  fieldKey String
  kind String
  state String @default("open")
  candidates Json
  fingerprint String
  resolvedRevision Int?
  createdAt DateTime @default(now())
  provider String @default("test_fixture_v1")
  model String?
  asset BoilerAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  @@unique([jobId, fieldKey])
  @@index([assetId, state, createdAt, id])
}
model AssetHistory {
  id String @id @default(uuid())
  assetId String
  kind String
  confirmationId String?
  note String?
  changes Json
  provider String?
  model String?
  createdAt DateTime @default(now())
  asset BoilerAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@index([assetId, createdAt, id])
}
model ReviewRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  operation String
  target String
  key String
  digest String
  response Json
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, operation, target, key])
}

model AiCampaign {
  id String @id
  limitMicroUsd Int
  maxCalls Int
  attempts AiAttempt[]
  createdAt DateTime @default(now())
}
model AiAttempt {
  id String @id @default(uuid())
  jobId String @unique
  campaignId String
  model String
  promptVersion String
  inputMicroUsdPerToken Int
  outputMicroUsdPerToken Int
  reservedMicroUsd Int
  actualMicroUsd Int?
  state String @default("reserved")
  sentAt DateTime?
  response Json?
  responseAt DateTime?
  providerRequestId String?
  inputTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  campaign AiCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  @@index([campaignId, state])
}
