generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum HomeRole {
  owner
  member
  viewer
}
model Account {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
  memberships HomeMembership[]
  requests HomeRequest[]
  documents Document[]
  uploads UploadRequest[]
}
model Session {
  id String @id
  accountId String?
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Home {
  id String @id @default(uuid())
  name String
  address String
  version Int @default(1)
  createdAt DateTime @default(now())
  memberships HomeMembership[]
  requests HomeRequest[]
  documents Document[]
  uploads UploadRequest[]
}
model HomeMembership {
  id String @id @default(uuid())
  accountId String
  homeId String
  role HomeRole @default(owner)
  validFrom DateTime @default(now())
  validUntil DateTime?
  revokedAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([accountId, homeId])
}
model HomeRequest {
  id String @id @default(uuid())
  accountId String
  key String
  digest String
  homeId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([accountId, key])
}

enum DocumentVisibility {
  private
  home
}
model Document {
  id String @id @default(uuid())
  homeId String
  uploaderId String
  name String
  visibility DocumentVisibility @default(private)
  createdAt DateTime @default(now())
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  uploader Account @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  original DocumentVersion?
  requests UploadRequest[]
  @@index([homeId, createdAt, id])
}
model DocumentVersion {
  id String @id @default(uuid())
  documentId String @unique
  version Int @default(1)
  originalFilename String
  mimeType String
  byteSize Int
  sha256 String
  fileId String @unique
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
}
model StoredFile {
  id String @id @default(uuid())
  storageKey String @unique
  createdAt DateTime @default(now())
  original DocumentVersion?
}
model UploadRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  key String
  digest String
  documentId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, key])
}
