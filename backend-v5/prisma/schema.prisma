generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum HomeRole {
  owner
  member
  viewer
}
model Account {
  contacts HomeContact[]
  onboardingComparisons ObjectOnboardingComparison[]
  onboardingDrafts ObjectOnboardingDraft[]
  onboardingJobs ObjectOnboardingJob[]
  onboardingRequests ObjectOnboardingRequest[]
  onboardingBindings ObjectOnboardingBinding[]
  documentOrganizations DocumentOrganization[]
  documentIntakeBatches DocumentIntakeBatch[]
  receiptJobs ReceiptAnalysisJob[]
  receiptFields ReceiptObjectField[]
  receiptComparisons ReceiptComparison[]
  receiptDrafts ReceiptDraft[]
  receiptRequests ReceiptRequest[]
  authChallenges AuthChallenge[]
  emailVerifiedAt DateTime?
  requiresEmailVerification Boolean @default(false)
  sharePreviews SharePreview[] @relation("SharePreviewSender")
  sentShares ShareRecord[] @relation("ShareSender")
  receivedShares ShareRecord[] @relation("ShareRecipient")
  shareClaims ShareRecord[] @relation("ShareClaimant")
  shareRequests ShareRequest[]
  shareEvents ShareEvent[]
  economicJobs EconomicAnalysisJob[]
  economicDrafts EconomicDraft[]
  economicWorks EconomicWork[]
  economicWorkEvents EconomicWorkHistory[]
  economicRequests EconomicRequest[]
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
  memberships HomeMembership[]
  requests HomeRequest[]
  documents Document[]
  uploads UploadRequest[]
  analysisJobs AnalysisJob[]
  boilerAssets BoilerAsset[]
  reviewRequests ReviewRequest[]
  activities HomeActivity[]
  activityRequests ActivityRequest[]
  activityHistory ActivityHistory[]
  expenses HomeExpense[]
  expenseRequests ExpenseRequest[]
  expenseHistory ExpenseHistory[]
  objectRecords HomeObject[]
  objectPositions ObjectPosition[]
  objectLinks ObjectResourceLink[]
  objectEvents ObjectEvent[]
  objectRequests ObjectRequest[]
}
model AuthChallenge {
  id String @id @default(uuid())
  accountId String
  purpose String
  tokenHash String @unique
  emailFingerprint String
  expiresAt DateTime
  consumedAt DateTime?
  deliveryState String @default("queued")
  createdAt DateTime @default(now())
  account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
  @@index([accountId,purpose,expiresAt])
  @@index([expiresAt])
}
model AuthThrottle {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}
model Session {
  id String @id
  accountId String?
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Home {
  contacts HomeContact[]
  onboardingComparisons ObjectOnboardingComparison[]
  onboardingDrafts ObjectOnboardingDraft[]
  onboardingJobs ObjectOnboardingJob[]
  onboardingRequests ObjectOnboardingRequest[]
  onboardingBindings ObjectOnboardingBinding[]
  documentOrganizations DocumentOrganization[]
  documentIntakeBatches DocumentIntakeBatch[]
  receiptJobs ReceiptAnalysisJob[]
  receiptFields ReceiptObjectField[]
  receiptComparisons ReceiptComparison[]
  receiptDrafts ReceiptDraft[]
  receiptRequests ReceiptRequest[]
  sharePreviews SharePreview[]
  shares ShareRecord[]
  economicJobs EconomicAnalysisJob[]
  economicDrafts EconomicDraft[]
  economicWorks EconomicWork[]
  economicRequests EconomicRequest[]
  id String @id @default(uuid())
  name String
  address String
  version Int @default(1)
  createdAt DateTime @default(now())
  memberships HomeMembership[]
  requests HomeRequest[]
  documents Document[]
  uploads UploadRequest[]
  analysisJobs AnalysisJob[]
  boilerAssets BoilerAsset[]
  reviewRequests ReviewRequest[]
  activities HomeActivity[]
  activityRequests ActivityRequest[]
  expenses HomeExpense[]
  expenseRequests ExpenseRequest[]
  rooms HomeRoom[]
  objectRecords HomeObject[]
  objectPositions ObjectPosition[]
  objectLinks ObjectResourceLink[]
  objectEvents ObjectEvent[]
  objectRequests ObjectRequest[]
}

model SharePreview {
  id String @id @default(uuid())
  senderId String
  homeId String
  recipientKind String
  recipientId String?
  manifest Json
  fingerprint String
  validUntil DateTime
  createdAt DateTime @default(now())
  consumedBy String? @unique
  sender Account @relation("SharePreviewSender", fields: [senderId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  @@index([senderId, homeId, createdAt])
}
model ShareRecord {
  id String @id @default(uuid())
  senderId String
  homeId String
  recipientKind String
  recipientId String?
  state String
  version Int @default(1)
  manifest Json
  expiresAt DateTime
  codeHash String? @unique
  codeExpiresAt DateTime?
  claimId String? @unique
  claimAccountId String?
  comparisonCode String?
  claimExpiresAt DateTime?
  pairConfirmedAt DateTime?
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  sender Account @relation("ShareSender", fields: [senderId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  recipient Account? @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  claimant Account? @relation("ShareClaimant", fields: [claimAccountId], references: [id], onDelete: Restrict)
  events ShareEvent[]
  @@index([senderId, homeId, createdAt, id])
  @@index([recipientId, createdAt, id])
  @@index([claimAccountId, createdAt, id])
}
model ShareRequest {
  id String @id @default(uuid())
  accountId String
  key String
  digest String
  resourceKind String
  resourceId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([accountId, key])
}
model ShareEvent {
  id String @id @default(uuid())
  shareId String
  actorId String
  kind String
  version Int
  createdAt DateTime @default(now())
  share ShareRecord @relation(fields: [shareId], references: [id], onDelete: Restrict)
  actor Account @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([shareId, createdAt])
}
model ShareThrottle {
  key String @id
  windowStart DateTime
  attempts Int
  @@index([windowStart])
}
model HomeMembership {
  id String @id @default(uuid())
  accountId String
  homeId String
  role HomeRole @default(owner)
  validFrom DateTime @default(now())
  validUntil DateTime?
  revokedAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([accountId, homeId])
}
model HomeRequest {
  id String @id @default(uuid())
  accountId String
  key String
  digest String
  homeId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([accountId, key])
}

enum DocumentVisibility {
  private
  home
}
model Document {
  onboardingComparisons ObjectOnboardingComparison[]
  onboardingDrafts ObjectOnboardingDraft[]
  onboardingJobs ObjectOnboardingJob[]
  onboardingBindings ObjectOnboardingBinding[]
  organizations DocumentOrganization[]
  intakeItems DocumentIntakeItem[]
  receiptJobs ReceiptAnalysisJob[]
  receiptFields ReceiptObjectField[]
  receiptDrafts ReceiptDraft[]
  economicJobs EconomicAnalysisJob[]
  economicDrafts EconomicDraft[]
  objectLinks ObjectResourceLink[]
  id String @id @default(uuid())
  homeId String
  uploaderId String
  name String
  visibility DocumentVisibility @default(private)
  createdAt DateTime @default(now())
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  uploader Account @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  original DocumentVersion?
  requests UploadRequest[]
  expenses HomeExpense[]
  @@index([homeId, createdAt, id])
}
model DocumentVersion {
  fileControlEngine String?
  fileControlCheckedAt DateTime?
  fileControlSignature String?
  id String @id @default(uuid())
  documentId String @unique
  version Int @default(1)
  originalFilename String
  mimeType String
  byteSize Int
  sha256 String
  fileId String @unique
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
}
model StoredFile {
  id String @id @default(uuid())
  storageKey String @unique
  createdAt DateTime @default(now())
  original DocumentVersion?
}
model UploadRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  key String
  digest String
  documentId String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, key])
}

model BoilerAsset {
  objectPosition ObjectPosition?
  objectLinks ObjectResourceLink[]
  expenses HomeExpense[]
  activities HomeActivity[]
  id String @id @default(uuid())
  homeId String
  accountId String
  name String
  version Int @default(1)
  confirmed Json @default("{}")
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  jobs AnalysisJob[]
  proposals FieldProposal[]
  history AssetHistory[]
  @@index([accountId, homeId, createdAt, id])
}

enum ActivityState {
  open
  completed
  cancelled
}
model HomeActivity {
  economicWorks EconomicWork[]
  objectLinks ObjectResourceLink[]
  id String @id @default(uuid())
  accountId String
  homeId String
  assetId String?
  title String
  description String?
  dueDate String?
  state ActivityState @default(open)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  completedAt DateTime?
  cancelledAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  asset BoilerAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  history ActivityHistory[]
  @@index([accountId, homeId, state, dueDate, createdAt, id])
}
model ActivityHistory {
  id String @id @default(uuid())
  activityId String
  accountId String
  at DateTime @default(now())
  kind String
  note String?
  before Json?
  after Json
  activity HomeActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([activityId, at, id])
}
model ActivityRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  operation String
  target String
  key String
  digest String
  response Json
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, operation, target, key])
}
model AnalysisJob {
  id String @id @default(uuid())
  homeId String
  accountId String
  assetId String?
  parentJobId String?
  state String @default("queued")
  documents Json
  createdAt DateTime @default(now())
  firstStartedAt DateTime?
  finishedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  outcome String?
  openReviewCount Int?
  error Json?
  provider String @default("test_fixture_v1")
  model String?
  consentToProviderTransfer Boolean @default(false)
  attempt AiAttempt?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  asset BoilerAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  proposals FieldProposal[]
  @@index([state, leaseUntil])
  @@index([accountId, homeId, createdAt, id])
}
model FieldProposal {
  id String @id @default(uuid())
  assetId String
  jobId String
  fieldKey String
  kind String
  state String @default("open")
  candidates Json
  fingerprint String
  resolvedRevision Int?
  createdAt DateTime @default(now())
  provider String @default("test_fixture_v1")
  model String?
  asset BoilerAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  @@unique([jobId, fieldKey])
  @@index([assetId, state, createdAt, id])
}
model AssetHistory {
  id String @id @default(uuid())
  assetId String
  kind String
  confirmationId String?
  note String?
  changes Json
  provider String?
  model String?
  createdAt DateTime @default(now())
  asset BoilerAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@index([assetId, createdAt, id])
}
model ReviewRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  operation String
  target String
  key String
  digest String
  response Json
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  @@unique([accountId, homeId, operation, target, key])
}

enum ExpenseState {
  active
  archived
}
model HomeExpense {
  analysisDraftId String?
  economicProvenance Json?
  analysisDraft EconomicDraft? @relation("amountSource",fields:[analysisDraftId],references:[id],onDelete:Restrict)
  confirmedDrafts EconomicDraft[] @relation("confirmationExpense")
  category String?
  supplier String?
  documentNumber String?
  documentDate String?
  competenceFrom String?
  competenceTo String?
  dueOn String?
  amountOrigin String @default("user_declared")
  workId String?
  work EconomicWork? @relation(fields:[workId], references:[id], onDelete:Restrict)
  objectLinks ObjectResourceLink[]
  id String @id @default(uuid())
  accountId String
  homeId String
  documentId String?
  assetId String?
  title String
  amountCents Int
  spentOn String
  note String?
  state ExpenseState @default(active)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  archivedAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  asset BoilerAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  history ExpenseHistory[]
  @@index([accountId, homeId, state, spentOn, createdAt, id])
  @@index([accountId, homeId, documentId])
  @@index([accountId, homeId, assetId])
  @@index([accountId, homeId, category, state, spentOn])
  @@index([accountId, homeId, workId])
}

model EconomicWork {
  id String @id @default(uuid())
  accountId String
  homeId String
  name String
  note String?
  activityId String?
  activity HomeActivity? @relation(fields:[activityId], references:[id], onDelete:Restrict)
  state String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  archivedAt DateTime?
  expenses HomeExpense[]
  history EconomicWorkHistory[]
  account Account @relation(fields:[accountId], references:[id], onDelete:Restrict)
  home Home @relation(fields:[homeId], references:[id], onDelete:Restrict)
  @@index([accountId,homeId,state,createdAt,id])
}
model EconomicWorkHistory {
  id String @id @default(uuid())
  workId String
  accountId String
  kind String
  at DateTime @default(now())
  before Json?
  after Json
  work EconomicWork @relation(fields:[workId], references:[id], onDelete:Restrict)
  account Account @relation(fields:[accountId], references:[id], onDelete:Restrict)
  @@index([workId,at,id])
}
model EconomicRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  operation String
  target String
  key String
  digest String
  response Json
  createdAt DateTime @default(now())
  account Account @relation(fields:[accountId], references:[id], onDelete:Restrict)
  home Home @relation(fields:[homeId], references:[id], onDelete:Restrict)
  @@unique([accountId,homeId,operation,target,key])
}
model EconomicAnalysisJob {
  id String @id @default(uuid())
  accountId String
  homeId String
  documentId String
  documentVersion Int
  documentSha256 String
  provider String
  consentToProviderTransfer Boolean @default(false)
  state String @default("queued")
  version Int @default(1)
  errorCode String?
  leaseToken String?
  leaseUntil DateTime?
  firstStartedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  draft EconomicDraft?
  aiAttempt EconomicAiAttempt?
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  @@index([state,leaseUntil,createdAt,id])
  @@index([accountId,homeId,createdAt,id])
}
model EconomicAiCampaign {
  id String @id
  limitMicroUsd Int
  maxCalls Int
  createdAt DateTime @default(now())
  attempts EconomicAiAttempt[]
}
model EconomicAiAttempt {
  id String @id @default(uuid())
  jobId String @unique
  campaignId String
  model String
  promptVersion String
  inputMicroUsdPerToken Int
  outputMicroUsdPerToken Int
  reservedMicroUsd Int
  actualMicroUsd Int?
  state String @default("reserved")
  inputTokens Int?
  outputTokens Int?
  providerRequestId String?
  response Json?
  sentAt DateTime?
  responseAt DateTime?
  createdAt DateTime @default(now())
  job EconomicAnalysisJob @relation(fields:[jobId],references:[id],onDelete:Restrict)
  campaign EconomicAiCampaign @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  @@index([campaignId,state])
}
model EconomicDraft {
  id String @id @default(uuid())
  jobId String @unique
  accountId String
  homeId String
  documentId String
  documentVersion Int
  documentSha256 String
  documentKind String
  provider String
  state String @default("open")
  version Int @default(1)
  proposedFields Json
  amountCandidates Json
  amountSelectionRequired Boolean
  expenseId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  job EconomicAnalysisJob @relation(fields:[jobId],references:[id],onDelete:Restrict)
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  expense HomeExpense? @relation("confirmationExpense",fields:[expenseId],references:[id],onDelete:Restrict)
  amountExpenses HomeExpense[] @relation("amountSource")
  @@index([accountId,homeId,state,createdAt,id])
}

model HomeRoom {
  id String @id @default(uuid())
  homeId String
  name String
  type String
  note String?
  state String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  home Home @relation(fields:[homeId], references:[id], onDelete:Restrict)
  @@index([homeId,state,createdAt,id])
}
model HomeObject {
  onboardingComparisons ObjectOnboardingComparison[]
  profile Json?
  onboardingBindings ObjectOnboardingBinding[]
  manual Json?
  receiptFields ReceiptObjectField[]
  receiptComparisons ReceiptComparison[]
  id String @id @default(uuid())
  accountId String
  homeId String
  name String
  type String
  note String?
  state String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  account Account @relation(fields:[accountId], references:[id], onDelete:Restrict)
  home Home @relation(fields:[homeId], references:[id], onDelete:Restrict)
  position ObjectPosition?
  links ObjectResourceLink[]
  @@index([accountId,homeId,state,createdAt,id])
}

model ObjectOnboardingDraft {
  comparisons ObjectOnboardingComparison[]
  id String @id @default(uuid())
  accountId String
  homeId String
  documentId String
  documentVersion Int
  documentSha256 String
  mode String
  state String @default("open")
  version Int @default(1)
  output Json
  review Json?
  decisions Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  job ObjectOnboardingJob?
  @@index([accountId,homeId,documentId,documentVersion,documentSha256])
  @@index([accountId,homeId,state,updatedAt,id])
}
model ObjectOnboardingJob {
  key String
  digest String
  firstStartedAt DateTime?
  id String @id @default(uuid())
  accountId String
  homeId String
  documentId String
  documentVersion Int
  documentSha256 String
  mimeType String
  provider String
  consentToProviderTransfer Boolean
  state String @default("queued")
  version Int @default(1)
  draftId String? @unique
  leaseToken String?
  leaseUntil DateTime?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  draft ObjectOnboardingDraft? @relation(fields:[draftId],references:[id],onDelete:Restrict)
  attempt ObjectOnboardingAttempt?
  @@index([state,createdAt,id])
  @@index([accountId,homeId,documentId,documentVersion,documentSha256])
  @@unique([accountId, homeId, key])
}
model ObjectOnboardingRequest {
  id String @id @default(uuid())
  accountId String
  homeId String
  operation String
  target String
  key String
  digest String
  response Json
  createdAt DateTime @default(now())
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  @@unique([accountId,homeId,operation,target,key])
}
model ObjectOnboardingBinding {
  id String @id @default(uuid())
  accountId String
  homeId String
  documentId String
  documentVersion Int
  documentSha256 String
  fingerprint String
  unitIndex Int
  objectId String
  createdAt DateTime @default(now())
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  object HomeObject @relation(fields:[objectId],references:[id],onDelete:Restrict)
  @@unique([accountId,homeId,fingerprint,unitIndex])
  @@index([accountId,homeId,objectId])
}
model ObjectOnboardingCampaign {
  id String @id
  limitMicroUsd Int
  maxCalls Int
  attempts ObjectOnboardingAttempt[]
}
model ObjectOnboardingComparison {
  id String @id @default(uuid())
  accountId String
  homeId String
  objectId String
  draftId String
  documentId String
  documentVersion Int
  documentSha256 String
  fieldKey String
  proposed Json
  fingerprint String
  state String @default("open")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  home Home @relation(fields:[homeId],references:[id],onDelete:Restrict)
  object HomeObject @relation(fields:[objectId],references:[id],onDelete:Restrict)
  draft ObjectOnboardingDraft @relation(fields:[draftId],references:[id],onDelete:Restrict)
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  @@unique([accountId,homeId,objectId,fieldKey,fingerprint])
  @@index([accountId,homeId,state,objectId])
}
model ObjectOnboardingAttempt {
  id String @id @default(uuid())
  jobId String @unique
  campaignId String
  model String
  promptVersion String
  state String @default("reserved")
  reservedMicroUsd Int
  actualMicroUsd Int?
  inputMicroUsdPerToken Int
  outputMicroUsdPerToken Int
  inputTokens Int?
  outputTokens Int?
  providerRequestId String?
  output Json?
  sentAt DateTime?
  responseAt DateTime?
  job ObjectOnboardingJob @relation(fields:[jobId],references:[id],onDelete:Restrict)
  campaign ObjectOnboardingCampaign @relation(fields:[campaignId],references:[id],onDelete:Restrict)
}
model ObjectPosition {
  id String @id @default(uuid())
  accountId String
  homeId String
  objectId String? @unique
  boilerId String? @unique
  version Int @default(1)
  roomIds Json
  account Account @relation(fields:[accountId], references:[id], onDelete:Restrict)
  home Home @relation(fields:[homeId], references:[id], onDelete:Restrict)
  object HomeObject? @relation(fields:[objectId], references:[id], onDelete:Restrict)
  boiler BoilerAsset? @relation(fields:[boilerId], references:[id], onDelete:Restrict)
